rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Todo mundo com conta e e-mail confirmado é admin: vê e edita tudo
    // (cobranças de todos, compras, modelos, chave PIX).
    function isAdmin() {
      return verificado();
    }

    function isDono(divida) {
      return verificado() && (
        divida.devedorEmail == request.auth.token.email
        || divida.get('devedorUid', null) == request.auth.uid
      );
    }

    // Lista de recebedores.
    match /config/admins {
      allow read: if request.auth != null;
      // Primeiro acesso: se ainda não há recebedor, uma conta verificada
      // pode se definir como recebedor (só ela mesma).
      allow create: if verificado()
        && request.resource.data.emails == [request.auth.token.email];
      // Depois disso, só um recebedor adiciona/remove outros (nunca deixando vazio).
      allow update: if isAdmin()
        && request.resource.data.emails is list
        && request.resource.data.emails.size() > 0;
    }

    // Chave PIX: qualquer usuário logado lê, só recebedor altera.
    match /config/pix {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Perfil (nome + e-mail): a pessoa grava o próprio; o recebedor lê todos
    // para poder selecionar participantes de uma compra.
    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
    }

    // Finanças pessoais: cada pessoa só vê e mexe nas próprias transações.
    match /usuarios/{uid}/transacoes/{transacaoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.tipo in ['receita', 'despesa']
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.data is string;
    }

    // Modelos de compra em grupo: só quem recebe vê e edita.
    match /modelos/{modeloId} {
      allow read, write: if isAdmin();
    }

    match /dividas/{dividaId} {
      allow read: if isAdmin() || isDono(resource.data);

      allow create: if isAdmin()
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.devedorEmail is string
        && request.resource.data.status == 'pendente';

      allow delete: if isAdmin();

      // Recebedor altera qualquer coisa. O devedor só pode avisar que pagou:
      // pendente -> aguardando_confirmacao, sem mexer em mais nada.
      allow update: if isAdmin() || (
        isDono(resource.data)
        && resource.data.status == 'pendente'
        && request.resource.data.status == 'aguardando_confirmacao'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'informadoPagoEm'])
      );
    }
  }
}
